import matplotlib.pyplot as plt

labels = ['Unpadded\n(False Sharing)', 'Padded\n(64-byte Isolation)']
times = [2126, 503]
colors = ['#e74c3c', '#2ecc71']

plt.figure(figsize=(6, 4))
bars = plt.bar(labels, times, color=colors, width=0.5)
plt.ylabel('Execution Time (ms) [Lower is better]')
plt.title('EPAM COE Phase 2: False Sharing Benchmark\nSpeedup: 4.23x')

for bar in bars:
    yval = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2.0, yval + 50, f'{yval} ms', ha='center', va='bottom', fontweight='bold')

plt.ylim(0, 2500)
plt.tight_layout()
plt.savefig('results/benchmark_chart.png', dpi=300)
print("Chart saved to results/benchmark_chart.png")